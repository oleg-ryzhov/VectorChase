 src/camera/freeLook.js    | 53 ++++++++++++++++----------
 src/config/presets.js     |  2 +-
 src/config/registry.js    | 33 ++++------------
 src/game/style.js         | 12 +-----
 src/main.js               | 80 ++++++++++++++++++++++++++-------------
 src/physics/collisions.js |  6 +--
 src/physics/spec.js       |  4 --
 src/physics/vehicle.js    | 18 +--------
 src/ui/hud.js             | 13 ++-----
 src/ui/mainMenu.js        |  2 +-
 src/ui/settingsMenu.js    | 48 ++++++++++++++++++-----
 tests/style.test.mjs      | 33 +++++++---------
 tests/vehicle.test.mjs    | 57 +---------------------------
 14 files changed, 162 insertions(+), 209 deletions(-)

diff --git a/README.md b/README.md
index 0a56026..b25e165 100644
--- a/README.md
+++ b/README.md
@@ -30,12 +30,12 @@ See `docs/DESIGN.md`.
 
 - W / S: accelerate / brake (hold S when stopped to reverse)
 - A / D: steer
-- C: switch between first-person and chase camera
+- C: cycle the camera: first-person, chase, rear (the chase view turned around)
 - E: open or close the car settings during a race (time slows down while it is open)
-- R: put the car back on the road
-- Space: handbrake (start a drift). Shift: boost (drifting fills the meter)
-- Hold the left mouse button (or drag a finger) and move: free-look around the car; the wheel zooms
-- Assists (stability, countersteer, boost) can be tuned in the E menu under Assists
+- Space: handbrake (start a drift)
+- Hold the left mouse button (or drag a finger) and move: free-look around the car, starting from the chase camera; the wheel zooms
+- There are no driving assists: the car behaves like a real one, and walls and cars act as solid obstacles
+- The E menu has Basic (the main settings), Advanced (everything else) and Presets tabs
 
 ## Troubleshooting
 
diff --git a/src/camera/freeLook.js b/src/camera/freeLook.js
index 86dd5fa..88e72fe 100644
--- a/src/camera/freeLook.js
+++ b/src/camera/freeLook.js
@@ -1,15 +1,23 @@
-// Free-look orbit around the car, driven by holding the mouse button and dragging.
+// Free-look offsets applied on top of the chase camera, driven by holding the mouse button and dragging.
+// All values are offsets from the chase pose, so free look starts exactly where the chase camera is.
 // Pure logic: no DOM or Three.js imports.
 
-const DEFAULT_PITCH = 0.25;
+const INVERT_X = false; // true makes dragging right orbit the camera right instead of left
+const INVERT_Y = false; // true makes dragging down lower the camera instead of raising it
+const MIN_PITCH = -0.1; // rad, lowest total camera pitch
+const MAX_PITCH = 1.4; // rad, highest total camera pitch
+const MIN_OFFSET = -0.35; // limits on the pitch offset, so no drag is wasted past the total limits above
+const MAX_OFFSET = 1.15;
+const MIN_ZOOM = 0.5;
+const MAX_ZOOM = 2;
 
 export class FreeLook {
   constructor() {
-    this.yaw = 0; // 0 = straight behind the car
-    this.pitch = DEFAULT_PITCH;
-    this.radius = 7;
+    this.yaw = 0; // rad around the car; 0 = the chase camera's own position
+    this.pitch = 0; // rad added to the chase camera's pitch
+    this.zoomScale = 1; // multiplier on the chase camera's distance
     this.active = false; // the button is held
-    this.engaged = false; // active, or still easing back to the normal camera
+    this.engaged = false; // active, or still easing back to the chase camera
   }
 
   start() {
@@ -19,39 +27,44 @@ export class FreeLook {
 
   end() {
     this.active = false;
+    // Take the short way back after several turns.
+    this.yaw = Math.atan2(Math.sin(this.yaw), Math.cos(this.yaw));
   }
 
+  // Dragging right moves the camera left around the car, so the scene appears to follow the mouse.
   drag(dx, dy) {
     if (!this.active) return;
-    this.yaw -= dx * 0.006;
-    this.pitch = Math.min(1.4, Math.max(-0.1, this.pitch + dy * 0.005));
+    this.yaw += dx * 0.006 * (INVERT_X ? -1 : 1);
+    this.pitch = Math.min(MAX_OFFSET, Math.max(MIN_OFFSET, this.pitch + dy * 0.005 * (INVERT_Y ? -1 : 1)));
   }
 
   zoom(amount) {
-    this.radius = Math.min(16, Math.max(4, this.radius + amount * 0.01));
+    if (!this.engaged) return;
+    this.zoomScale = Math.min(MAX_ZOOM, Math.max(MIN_ZOOM, this.zoomScale * Math.exp(amount * 0.001)));
   }
 
-  // Eases back to the normal camera after the button is released.
+  // Eases back to the chase camera after the button is released.
   update(dt) {
     if (this.active || !this.engaged) return;
     const k = Math.exp(-dt * 3);
     this.yaw *= k;
-    this.pitch = DEFAULT_PITCH + (this.pitch - DEFAULT_PITCH) * k;
-    if (Math.abs(this.yaw) < 0.02 && Math.abs(this.pitch - DEFAULT_PITCH) < 0.02) {
+    this.pitch *= k;
+    this.zoomScale = 1 + (this.zoomScale - 1) * k;
+    if (Math.abs(this.yaw) < 0.02 && Math.abs(this.pitch) < 0.02 && Math.abs(this.zoomScale - 1) < 0.02) {
       this.yaw = 0;
-      this.pitch = DEFAULT_PITCH;
+      this.pitch = 0;
+      this.zoomScale = 1;
       this.engaged = false;
     }
   }
 
-  // Camera position around a pivot for a car heading carYaw.
-  position(pivot, carYaw) {
-    const a = carYaw + Math.PI + this.yaw;
-    const c = Math.cos(this.pitch);
+  // Applies the offsets to a base orbit: angle (rad, where the camera sits around the pivot),
+  // pitch (rad above the horizon) and radius (m).
+  orbit(angle, pitch, radius) {
     return {
-      x: pivot.x + this.radius * c * Math.cos(a),
-      y: pivot.y + this.radius * Math.sin(this.pitch),
-      z: pivot.z + this.radius * c * Math.sin(a),
+      angle: angle + this.yaw,
+      pitch: Math.min(MAX_PITCH, Math.max(MIN_PITCH, pitch + this.pitch)),
+      radius: radius * this.zoomScale,
     };
   }
 }
